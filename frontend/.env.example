# Public address of this website. Used to build the product link and product image URL
# inside the WhatsApp message, so the shop owner can open them. It MUST be a public https
# address (not localhost) once the site is deployed. Copy this file to .env and edit.
VITE_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: change only if the API is hosted elsewhere (default is /api via the dev proxy)
# VITE_API_URL=https://api.your-domain.com/api
